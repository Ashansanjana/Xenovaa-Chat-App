PORT=5000
# Comma-separate multiple allowed origins if you have both a dev server and a
# deployed web frontend, e.g.: http://localhost:5173,https://chat.example.com
# The Electron desktop app sends no Origin header (file://) and is always allowed.
CLIENT_URL=http://localhost:5173

# Supabase project settings (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Supabase Storage bucket for chat uploads
SUPABASE_STORAGE_BUCKET=chat-uploads

# Supabase Storage bucket for profile pictures (must be a PUBLIC bucket)
SUPABASE_AVATAR_BUCKET=avatars
